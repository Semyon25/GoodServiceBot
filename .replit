modules = ["python-3.12"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram bot"

[[workflows.workflow]]
name = "Telegram bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m bot"

[workflows.workflow.metadata]
outputType = "console"

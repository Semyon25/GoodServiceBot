# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:replace-me

# Telegram ID администраторов через запятую (обязательно)
ADMIN_IDS=111111111,222222222

# Путь к файлу базы SQLite (по умолчанию data/bot.sqlite3)
DB_PATH=data/bot.sqlite3

# Прокси для связи с api.telegram.org (необязательно), если Telegram недоступен из вашей сети.
# Поддерживаются http://, socks5://, socks4://, в т.ч. с логином: socks5://user:password@host:1080
PROXY_URL=

# Часовой пояс расписания
TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Интервал фоновых проверок (напоминания о подписке, неназначенные заявки), секунд
JOBS_INTERVAL_SECONDS=60
